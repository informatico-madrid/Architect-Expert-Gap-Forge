# ==============================================================================
# AEGF DATA FACTORY - INFRASTRUCTURE CONFIGURATION (TEMPLATE)
# Rename this file to .env and fill in your local paths.
# ==============================================================================

# --- PROJECT PATHS (Host perspective) ---
# Point this to the root of the Architect-Expert-Gap-Forge repository
AEGF_PROJECT_ROOT=../../

# --- STORAGE PATHS (Host perspective) ---
# Where your large datasets and raw clones are stored
AEGF_DATA_BASE_PATH=/path/to/your/storage/data_factory
# Where your LLM weights (Llama, DeepSeek, etc.) reside
AEGF_MODELS_DIR=/path/to/your/models
# HuggingFace cache to avoid re-downloading
AEGF_HF_CACHE=~/.cache/huggingface

# --- COMPUTATIONAL RESOURCES ---
# Options: 'all' or specific IDs like '0,1'
AEGF_GPUS=all
# Shared memory (recommended 16gb+ for deepspeed/training)
AEGF_SHM_SIZE=16gb
# CPU maximum limit (set to total cores minus 1 for system stability)
AEGF_CPU_LIMIT=
# Memory + Swap limit for Docker containers (adjust based on your system's RAM)
AEGF_RAM_SWAP_LIMIT=
AEGF_ULIMIT_MEMORY_STACK=
# --- DOCKER IMAGES (Versions) ---
# Use 'main-latest' for the bleeding edge or specific tags for stability
AEGF_IMAGE_AXOLOTL=axolotlai/axolotl:main-latest
AEGF_IMAGE_NEMO=nvcr.io/nvidia/nemo-curator:25.09

# --- TELEMETRY & SECRETS ---
# Get your key from https://wandb.ai/authorize
AEGF_WANDB_API_KEY=your_wandb_key_here
# Set to 1 to disable tracking
AEGF_DO_NOT_TRACK=1