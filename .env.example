# AEGF Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# =============================================================================
# API Keys
# =============================================================================

# API key for OpenAI models
OPENAI_API_KEY=

# API key for Anthropic/Claude models
ANTHROPIC_API_KEY=

# API key for vLLM/OpenAI-compatible endpoints
AEGF_API_KEY=

# Google API key for Gemini models
GOOGLE_API_KEY=

# GitHub token for authenticated API requests
GITHUB_TOKEN=

# =============================================================================
# Output Paths
# =============================================================================

# Output path for Stage 3 curated JSONL dataset
STAGE3_OUTPUT_JSONL=

# =============================================================================
# Optional: Model Configuration
# =============================================================================

# Default model (uncomment and modify as needed)
# AEGF_DEFAULT_MODEL=qwen3-30b-a3b-thinking-fp8

# Default base URL for inference
# AEGF_BASE_URL=http://localhost:8000/v1
