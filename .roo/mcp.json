{
	"mcpServers": {
		"qdrant-memoria": {
			"command": "uvx",
			"args": [
				"mcp-server-qdrant"
			],
			"env": {
				"QDRANT_URL": "http://192.168.1.201:6333",
				"COLLECTION_NAME": "data_factory_context"
			},
			"alwaysAllow": [
				"qdrant-find",
				"qdrant-store"
			]
		},
		"playwright": {
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@0.0.38"
			],
			"alwaysAllow": [
				"browser_navigate"
			]
		}
	}
}