  "specialized_records": [
    {
      "id": "spec_001",
      "messages": [
        {"role": "user", "content": "How do I configure a sensor in Home Assistant?"},
        {"role": "assistant", "content": "You can configure a sensor using the YAML configuration file. Here's an example:\n\n```yaml\nsensor:\n  - platform: template\n    sensors:\n      my_sensor:\n        value_template: \"{{ states('sensor.temperature') }}\"\n```"}
      ],
      "metadata": {"origin": "specialized", "type": "qa", "token_count": 50}
    },
    {
      "id": "spec_002",
      "messages": [
        {"role": "user", "content": "What is the best way to automate lights?"},
        {"role": "assistant", "content": "Use automation with triggers, conditions, and actions. Here's an example:\n\n```yaml\nautomation:\n  - alias: Turn on lights at sunset\n    trigger:\n      platform: sun\n      event: sunset\n    action:\n      service: light.turn_on\n      entity_id: light.living_room\n```"}
      ],
      "metadata": {"origin": "specialized", "type": "qa", "token_count": 45}
    },
    {
      "id": "spec_003",
      "messages": [
        {"role": "user", "content": "How to set up ESPHome?"},
        {"role": "assistant", "content": "ESPHome is a system to control your microcontrollers by Home Assistant. First, install the add-on, then create a YAML config file."}
      ],
      "metadata": {"origin": "specialized", "type": "qa", "token_count": 35}
    },
    {
      "id": "spec_004",
      "messages": [
        {"role": "user", "content": "Create a Python script for Home Assistant"},
        {"role": "assistant", "content": "Here's a simple script:\n\n```python\nimport hass_api\n\ndef main():\n    states = hass_api.get_states()\n    return states\n```"}
      ],
      "metadata": {"origin": "specialized", "type": "code", "token_count": 30}
    },
    {
      "id": "spec_005",
      "messages": [
        {"role": "user", "content": "Explain MQTT in Home Assistant"},
        {"role": "assistant", "content": "MQTT is a lightweight messaging protocol for small sensors and mobile devices. In Home Assistant, you configure it in configuration.yaml with the mqtt integration."}
      ],
      "metadata": {"origin": "specialized", "type": "explanation", "token_count": 40}
    }
  ],
  "anchor_records": [
    {
      "id": "anchor_001",
      "messages": [
        {"role": "user", "content": "What is machine learning?"},
        {"role": "assistant", "content": "Machine learning is a subset of artificial intelligence that enables systems to learn and improve from experience without being explicitly programmed."}
      ],
      "metadata": {"origin": "anchor", "type": "general", "token_count": 35}
    },
    {
      "id": "anchor_002",
      "messages": [
        {"role": "user", "content": "Explain neural networks"},
        {"role": "assistant", "content": "Neural networks are computing systems inspired by biological neural networks. They consist of interconnected nodes that process information."}
      ],
      "metadata": {"origin": "anchor", "type": "general", "token_count": 40}
    },
    {
      "id": "anchor_003",
      "messages": [
        {"role": "user", "content": "What is deep learning?"},
        {"role": "assistant", "content": "Deep learning is a type of machine learning that uses multi-layered neural networks to solve complex problems."}
      ],
      "metadata": {"origin": "anchor", "type": "general", "token_count": 30}
    },
    {
      "id": "anchor_004",
      "messages": [
        {"role": "user", "content": "Define supervised learning"},
        {"role": "assistant", "content": "Supervised learning is a machine learning approach where models are trained on labeled data to predict outputs for new inputs."}
      ],
      "metadata": {"origin": "anchor", "type": "general", "token_count": 35}
    },
    {
      "id": "anchor_005",
      "messages": [
        {"role": "user", "content": "What is unsupervised learning?"},
        {"role": "assistant", "content": "Unsupervised learning involves finding patterns in unlabeled data without predefined labels or targets."}
      ],
      "metadata": {"origin": "anchor", "type": "general", "token_count": 32}
    },
    {
      "id": "anchor_006",
      "messages": [
        {"role": "user", "content": "Explain reinforcement learning"},
        {"role": "assistant", "content": "Reinforcement learning is a type of machine learning where an agent learns to make decisions by taking actions in an environment to maximize a reward."}
      ],
      "metadata": {"origin": "anchor", "type": "general", "token_count": 38}
    }
  ],
